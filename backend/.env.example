# =============================================================================
# Sahara Mzansi — Backend Environment Template
# Copy to backend/.env for local development. NEVER commit real secrets.
# =============================================================================

# Set DEMO_MODE=true to run locally with the pre-seeded Elena Rostova ledger
# (R248,500.00 net worth) even before pasting live cloud keys.
DEMO_MODE=true

# Service URLs & Ports
PORT=8000
COPILOT_RUNTIME_PORT=8200
FASTAPI_AGENT_URL=http://localhost:8000/copilotkit

# LLM Reasoning (Google Gemini — current SDK model: gemini-3.8-flash)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Grounded SA Financial Literacy Search (Tavily Free Tier: 1,000 credits/mo)
TAVILY_API_KEY=

# Supabase (System Layer — Free Tier)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# FinOps & Security Guardrails (ADR-005)
MAX_DAILY_TURNS_PER_USER=50
FICA_ID_HASH_PEPPER=change-me-in-production-32-chars
