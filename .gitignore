# ---------------------------------------------------------------------------
# Root .gitignore — global safety net for the Sahara Mzansi engineering repo.
# Covers OS/editor cruft, secrets, Android/Expo build outputs, Node, and Python.
# ---------------------------------------------------------------------------

# OS cruft
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editor / IDE / local AI session files
.idea/
.vscode/*
!.vscode/extensions.json
.claude/
*.swp
*.swo
*~

# Secrets & local env (never commit real keys)
.env
.env.*
!.env.example

# Node / Expo / React Native (Android)
**/node_modules/
**/.expo/
**/.expo-shared/
**/dist/
**/build/
**/android/.gradle/
**/android/app/build/
**/android/local.properties
*.apk
*.aab
*.jks
*.keystore
*.tsbuildinfo

# Python (CrewAI / FastAPI backend)
**/.venv/
**/venv/
**/__pycache__/
**/*.py[cod]
**/*.egg-info/
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/

# Logs
*.log
npm-debug.log*
yarn-error.log*
