# Optional. Without a key the copilot runs in offline "demo mode"
# (a rule-based mock model that still calls the same app actions).
OPENAI_API_KEY=
# Optional model override (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini
# Opt out of CopilotKit runtime telemetry
COPILOTKIT_TELEMETRY_DISABLED=true
