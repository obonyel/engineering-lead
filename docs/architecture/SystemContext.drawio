        <mxCell id="title" value="&lt;b style=&quot;font-size:20px&quot;&gt;System Context: Sahara Mzansi Agentic Banking Super App&lt;/b&gt;&lt;div&gt;[C4 Level 1] Android Expo client + CopilotKit AG-UI + CrewAI Flows + Gemini 2.5 Flash + Tavily + Supabase (&lt;= $20/mo)&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
