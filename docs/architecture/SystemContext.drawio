        <mxCell id="tavily" value="&lt;b&gt;Tavily Search API&lt;/b&gt;&lt;div&gt;[External System]&lt;/div&gt;&lt;br&gt;&lt;div&gt;Domain-restricted search (resbank.co.za, fsca.co.za, sars.gov.za) grounding SA financial literacy.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;fontColor=#ffffff;align=center;arcSize=8;strokeColor=#8A8A8A;" vertex="1" parent="1">
