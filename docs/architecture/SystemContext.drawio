<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram id="c4-system-context" name="C4 - System Context (Sahara Mzansi)">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0" />
