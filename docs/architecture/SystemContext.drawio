        </mxCell>

        <mxCell id="customer" value="&lt;b&gt;South African Customer&lt;/b&gt;&lt;div&gt;[Person]&lt;/div&gt;&lt;br&gt;&lt;div&gt;Onboards via FICA, tracks ZAR/USD wealth vaults, learns financial literacy, and approves PayShap transfers via Android biometrics.&lt;/div&gt;" style="html=1;dashed=0;whiteSpace=wrap;fillColor=#08427b;strokeColor=#073B6F;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="260" width="220" height="190" as="geometry" />
        </mxCell>

        <mxCell id="app" value="&lt;b&gt;Sahara Mzansi Android App&lt;/b&gt;&lt;div&gt;[Software System: React Native · Expo]&lt;/div&gt;&lt;br&gt;&lt;div&gt;Hosts onboarding, dashboard, and @copilotkit/react-native/headless AG-UI client. Renders native Generative UI cards and enforces Android BiometricPrompt clearance.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168bd;fontColor=#ffffff;align=center;arcSize=8;strokeColor=#0B4884;" vertex="1" parent="1">
          <mxGeometry x="360" y="245" width="320" height="220" as="geometry" />
        </mxCell>

        <mxCell id="platform" value="&lt;b&gt;Sahara Mzansi Backend&lt;/b&gt;&lt;div&gt;[Software System: CopilotRuntime v2 + FastAPI + CrewAI]&lt;/div&gt;&lt;br&gt;&lt;div&gt;Terminates AG-UI stream, runs Jabu/Kagiso/Thabo CrewAI Flows (CopilotKitState), enforces 6-step HITL &amp;amp; safe-float guardrails, and executes double-entry ledger logic.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438dd5;fontColor=#ffffff;align=center;arcSize=8;strokeColor=#2F6FA8;" vertex="1" parent="1">
          <mxGeometry x="860" y="245" width="340" height="220" as="geometry" />
        </mxCell>

        <mxCell id="gemini" value="&lt;b&gt;Google Gemini 2.5 Flash&lt;/b&gt;&lt;div&gt;[External System]&lt;/div&gt;&lt;br&gt;&lt;div&gt;Tool-calling, intent synthesis, and educational coaching within a $10/mo hard billing cap.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;fontColor=#ffffff;align=center;arcSize=8;strokeColor=#8A8A8A;" vertex="1" parent="1">
          <mxGeometry x="1420" y="60" width="300" height="150" as="geometry" />
