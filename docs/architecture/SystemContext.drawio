<mxfile host="app.diagrams.net" agent="Claude Code" version="24.0.0">
  <diagram id="c4-system-context" name="C4 - System Context">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b style=&quot;font-size:22px&quot;&gt;System Context diagram: Agentic Banking Super App&lt;/b&gt;&lt;div&gt;[C4 Level 1] How a React Native app integrates with AG-UI, agent frameworks, MCP, A2A, A2UI and a database&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1400" height="60" as="geometry" />
        </mxCell>

        <!-- Person -->
        <mxCell id="customer" value="&lt;b&gt;Banking Customer&lt;/b&gt;&lt;div&gt;[Person]&lt;/div&gt;&lt;br&gt;&lt;div&gt;Retail or business client who banks, pays and shops through the super app.&lt;/div&gt;" style="html=1;dashed=0;whiteSpace=wrap;fillColor=#08427b;strokeColor=#073B6F;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;resizable=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="280" width="200" height="180" as="geometry" />
        </mxCell>

        <!-- System in focus -->
        <mxCell id="app" value="&lt;b&gt;Banking Super App&lt;/b&gt;&lt;div&gt;[Software System: React Native, iOS / Android]&lt;/div&gt;&lt;br&gt;&lt;div&gt;Hosts chat and mini-apps. Contains an AG-UI client (streaming events, shared state, tool calls) and a native A2UI renderer that maps agent-declared UI to a trusted component catalog.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168bd;fontColor=#ffffff;align=center;arcSize=8;strokeColor=#0B4884;" vertex="1" parent="1">
          <mxGeometry x="340" y="260" width="300" height="220" as="geometry" />
        </mxCell>

        <!-- Agent platform -->
        <mxCell id="platform" value="&lt;b&gt;Agent Platform / Gateway&lt;/b&gt;&lt;div&gt;[Software System: AG-UI server]&lt;/div&gt;&lt;br&gt;&lt;div&gt;Terminates AG-UI from the app, authenticates the user, runs the orchestrator agent, enforces guardrails, and brokers access to tools, peer agents and state.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438dd5;fontColor=#ffffff;align=center;arcSize=8;strokeColor=#2F6FA8;" vertex="1" parent="1">
          <mxGeometry x="920" y="260" width="300" height="220" as="geometry" />
        </mxCell>

        <!-- External systems -->
        <mxCell id="frameworks" value="&lt;b&gt;Agent Frameworks&lt;/b&gt;&lt;div&gt;[External System]&lt;/div&gt;&lt;br&gt;&lt;div&gt;LangGraph, CrewAI, Google ADK, Microsoft Agent Framework, etc. Each exposes agents through an AG-UI adapter.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;fontColor=#ffffff;align=center;arcSize=8;strokeColor=#8A8A8A;" vertex="1" parent="1">
          <mxGeometry x="1500" y="40" width="300" height="180" as="geometry" />
        </mxCell>
        <mxCell id="mcp" value="&lt;b&gt;MCP Servers&lt;/b&gt;&lt;div&gt;[External System]&lt;/div&gt;&lt;br&gt;&lt;div&gt;Expose banking capabilities as tools, resources and prompts: accounts, payments, cards, KYC, product catalogue.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;fontColor=#ffffff;align=center;arcSize=8;strokeColor=#8A8A8A;" vertex="1" parent="1">
          <mxGeometry x="1500" y="280" width="300" height="180" as="geometry" />
        </mxCell>
        <mxCell id="a2a" value="&lt;b&gt;Remote Agents&lt;/b&gt;&lt;div&gt;[External System: A2A]&lt;/div&gt;&lt;br&gt;&lt;div&gt;Partner and merchant agents (insurance, travel, retail) discovered via Agent Cards and delegated tasks.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;fontColor=#ffffff;align=center;arcSize=8;strokeColor=#8A8A8A;" vertex="1" parent="1">
          <mxGeometry x="1500" y="520" width="300" height="180" as="geometry" />
        </mxCell>
        <mxCell id="db" value="&lt;b&gt;Agent State Database&lt;/b&gt;&lt;div&gt;[External System: PostgreSQL + pgvector]&lt;/div&gt;&lt;br&gt;&lt;div&gt;Conversation threads, checkpoints, long-term memory, embeddings, audit trail.&lt;/div&gt;" style="shape=cylinder3;size=15;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#999999;fontColor=#ffffff;strokeColor=#8A8A8A;align=center;" vertex="1" parent="1">
          <mxGeometry x="1500" y="760" width="300" height="200" as="geometry" />
        </mxCell>
        <mxCell id="core" value="&lt;b&gt;Core Banking &amp;amp; Payments&lt;/b&gt;&lt;div&gt;[External System]&lt;/div&gt;&lt;br&gt;&lt;div&gt;Systems of record for accounts, ledgers, cards and payment rails.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;fontColor=#ffffff;align=center;arcSize=8;strokeColor=#8A8A8A;" vertex="1" parent="1">
          <mxGeometry x="2080" y="280" width="300" height="180" as="geometry" />
        </mxCell>

        <!-- Relationships -->
        <mxCell id="e1" value="Uses&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[chat, mini-apps]&lt;/font&gt;" style="endArrow=blockThin;html=1;strokeColor=#707070;strokeWidth=1.5;labelBackgroundColor=default;" edge="1" parent="1" source="customer" target="app">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="&lt;b&gt;AG-UI&lt;/b&gt; &lt;font style=&quot;font-size:10px&quot;&gt;[HTTP SSE / WebSocket]&lt;/font&gt;&lt;br&gt;User messages out; streamed events, shared state and tool calls back" style="endArrow=blockThin;startArrow=blockThin;html=1;strokeColor=#1168bd;strokeWidth=2;labelBackgroundColor=default;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="app" target="platform">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="&lt;b&gt;A2UI&lt;/b&gt; &lt;font style=&quot;font-size:10px&quot;&gt;[declarative JSON, carried over AG-UI]&lt;/font&gt;&lt;br&gt;Agent describes UI; app renders it natively and returns user actions" style="endArrow=blockThin;startArrow=blockThin;html=1;strokeColor=#9673a6;strokeWidth=2;dashed=1;labelBackgroundColor=default;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="app" target="platform">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="Hosts and delegates to agents&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[framework SDK + AG-UI adapter]&lt;/font&gt;" style="endArrow=blockThin;html=1;strokeColor=#707070;strokeWidth=1.5;labelBackgroundColor=default;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="platform" target="frameworks">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="&lt;b&gt;MCP&lt;/b&gt; &lt;font style=&quot;font-size:10px&quot;&gt;[JSON-RPC, Streamable HTTP]&lt;/font&gt;&lt;br&gt;Discovers and calls tools, reads resources" style="endArrow=blockThin;html=1;strokeColor=#707070;strokeWidth=1.5;labelBackgroundColor=default;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="platform" target="mcp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="&lt;b&gt;A2A&lt;/b&gt; &lt;font style=&quot;font-size:10px&quot;&gt;[JSON-RPC / HTTPS]&lt;/font&gt;&lt;br&gt;Discovers Agent Cards, delegates tasks, streams results" style="endArrow=blockThin;startArrow=blockThin;html=1;strokeColor=#707070;strokeWidth=1.5;labelBackgroundColor=default;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="platform" target="a2a">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="Reads and writes state, memory, checkpoints&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[SQL / vector search]&lt;/font&gt;" style="endArrow=blockThin;startArrow=blockThin;html=1;strokeColor=#707070;strokeWidth=1.5;labelBackgroundColor=default;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="platform" target="db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="Executes banking operations&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[REST / ISO 20022]&lt;/font&gt;" style="endArrow=blockThin;html=1;strokeColor=#707070;strokeWidth=1.5;labelBackgroundColor=default;" edge="1" parent="1" source="mcp" target="core">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Legend -->
        <mxCell id="legend-title" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="700" width="120" height="24" as="geometry" />
        </mxCell>
        <mxCell id="lg1" value="Person" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427b;fontColor=#ffffff;strokeColor=#073B6F;" vertex="1" parent="1">
          <mxGeometry x="40" y="730" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="lg2" value="Software system in focus" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168bd;fontColor=#ffffff;strokeColor=#0B4884;" vertex="1" parent="1">
          <mxGeometry x="40" y="780" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="lg3" value="Internal supporting system" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438dd5;fontColor=#ffffff;strokeColor=#2F6FA8;" vertex="1" parent="1">
          <mxGeometry x="40" y="830" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="lg4" value="External system" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;fontColor=#ffffff;strokeColor=#8A8A8A;" vertex="1" parent="1">
          <mxGeometry x="40" y="880" width="200" height="40" as="geometry" />
        </mxCell>

        <!-- Notes -->
        <mxCell id="notes" value="&lt;b&gt;Design notes&lt;/b&gt;&lt;ul&gt;&lt;li&gt;The app never calls MCP, A2A or the database directly. Only the Agent Platform does, so credentials, consent and audit stay server-side.&lt;/li&gt;&lt;li&gt;AG-UI is the single agent-to-user channel. A2UI payloads travel inside it, so the app needs one transport and one renderer.&lt;/li&gt;&lt;li&gt;The A2UI renderer only instantiates components from an approved native catalog (no agent-supplied code), which matters for a regulated banking UI.&lt;/li&gt;&lt;li&gt;Framework choice is hidden behind AG-UI adapters, so agents can be swapped without app releases.&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#cccccc;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="340" y="620" width="880" height="200" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
